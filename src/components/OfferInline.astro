---
// Компактная карточка оффера в середине статьи: выглядит частью контента.
// Реальную позицию выбирает скрипт (см. ниже) — переносит блок к середине текста,
// потому что markdown рендерится целиком и «вставить в середину» на сервере нечем.
import { OFFER } from '../lib/site';
---
<aside class="oi" data-offer-inline>
  <a class="oi-link" href={OFFER.href} target="_blank" rel="noopener sponsored nofollow">
    <span class="oi-pic"><img src={OFFER.image} alt="" loading="lazy" width="120" height="90" /></span>
    <span class="oi-body">
      <span class="oi-head">{OFFER.head1} <b>{OFFER.head2}</b></span>
      <span class="oi-text">{OFFER.text}</span>
      <span class="oi-cta">{OFFER.cta} <span aria-hidden="true">→</span></span>
    </span>
  </a>
  <p class="oi-mark">{OFFER.disclosure}</p>
</aside>

<style>
  .oi {
    margin: 34px 0; border: 1px solid rgba(214, 51, 108, .14); border-radius: 18px;
    background: linear-gradient(135deg, #fdf1f1, #f8eef0); overflow: hidden;
    box-shadow: 0 8px 24px rgba(45, 26, 32, .06);
  }
  .oi-link { display: flex; gap: 16px; align-items: center; padding: 16px 18px; text-decoration: none; }
  .oi-pic {
    flex: 0 0 auto; width: 120px; height: 90px; border-radius: 12px; overflow: hidden; background: #f7e2e9;
  }
  .oi-pic img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
  .oi-link:hover .oi-pic img { transform: scale(1.05); }

  .oi-body { display: block; min-width: 0; }
  .oi-head {
    display: block; font-family: -apple-system, "Segoe UI", Arial, sans-serif; font-size: 17px;
    font-weight: 800; line-height: 1.25; color: #2d1a20;
  }
  .oi-head b { color: #e84c8b; font-weight: 800; }
  .oi-text { display: block; margin: 6px 0 10px; font-size: 14px; line-height: 1.45; color: #6b5860; }
  .oi-cta {
    display: inline-flex; align-items: center; gap: 8px; background: #e84c8b; color: #fff;
    font-size: 14px; font-weight: 700; padding: 9px 20px; border-radius: 999px;
    box-shadow: 0 6px 16px rgba(232, 76, 139, .26); transition: background .15s ease;
  }
  .oi-link:hover .oi-cta { background: #d6336c; }
  .oi-mark { margin: 0; padding: 0 18px 12px; font-size: 11px; line-height: 1.4; color: #9a8890; }

  @media (max-width: 560px) {
    .oi-link { flex-direction: column; align-items: flex-start; gap: 12px; padding: 14px; }
    .oi-pic { width: 100%; height: auto; aspect-ratio: 3 / 2; }
    .oi-head { font-size: 16px; }
  }
</style>

<script is:inline>
  // Переносим карточку к середине статьи: ищем ближайший h2 к середине текста,
  // чтобы блок встал на границе разделов, а не разрывал абзац.
  (function () {
    var card = document.querySelector('[data-offer-inline]');
    var prose = document.querySelector('.prose');
    if (!card || !prose) return;
    var heads = Array.prototype.slice.call(prose.querySelectorAll('h2'));
    if (heads.length < 3) return;
    var middle = prose.offsetTop + prose.offsetHeight / 2;
    var best = null, bestDist = Infinity;
    heads.forEach(function (h) {
      var d = Math.abs(h.offsetTop - middle);
      if (d < bestDist) { bestDist = d; best = h; }
    });
    if (best && best !== heads[0]) prose.insertBefore(card, best);
  })();
</script>
