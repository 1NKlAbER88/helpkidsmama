---
// 3 случайных (детерминированно по slug) оформленных отзыва с аватарками. Ставить после <Offer/>.
import { pickReviews } from '../lib/reviews';
export interface Props { slug: string; }
const { slug } = Astro.props;
const items = pickReviews(slug, 3);
---
<section class="reviews-block">
  <h2 class="rv-h">Отзывы родителей</h2>
  <div class="rv-grid">
    {items.map((r) => (
      <article class="rv-card">
        <div class="rv-top">
          <img class="rv-ava" src={r.avatar} alt={r.name} width="56" height="56" loading="lazy" />
          <div class="rv-meta">
            <span class="rv-name">{r.name}</span>
            <span class="rv-stars" aria-label="5 из 5">★★★★★</span>
          </div>
        </div>
        <p class="rv-title">«{r.title}»</p>
        <p class="rv-text">{r.text}</p>
      </article>
    ))}
  </div>
</section>
<style>
  .reviews-block{ max-width:920px; margin:46px auto 8px; padding:0 4px; }
  .rv-h{ font-family:-apple-system,"Segoe UI",Arial,sans-serif; font-size:1.55rem; font-weight:800; color:#2d1a20; text-align:center; margin:0 0 22px; }
  .rv-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .rv-card{ background:#fff; border:1px solid rgba(45,26,32,.08); border-radius:18px; padding:20px 20px 22px; box-shadow:0 8px 26px rgba(45,26,32,.06); display:flex; flex-direction:column; }
  .rv-top{ display:flex; align-items:center; gap:12px; margin-bottom:12px; }
  .rv-ava{ width:56px; height:56px; border-radius:50%; object-fit:cover; flex:0 0 auto; background:#f3e9ec; }
  .rv-meta{ display:flex; flex-direction:column; gap:2px; }
  .rv-name{ font-family:-apple-system,"Segoe UI",Arial,sans-serif; font-weight:700; color:#2d1a20; font-size:1rem; }
  .rv-stars{ color:#f5a623; font-size:.95rem; letter-spacing:2px; }
  .rv-title{ font-family:-apple-system,"Segoe UI",Arial,sans-serif; font-weight:700; color:#d6336c; font-size:1.03rem; margin:0 0 8px; line-height:1.3; }
  .rv-text{ color:#5b4a52; font-size:.95rem; line-height:1.55; margin:0; font-family:-apple-system,"Segoe UI",Arial,sans-serif; }
  @media(max-width:820px){ .rv-grid{ grid-template-columns:1fr; } }
</style>
