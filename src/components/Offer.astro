---
import { OFFER } from '../lib/site';
---
<section class="offer-block reveal">
  <div class="ob-card">
    <div class="ob-copy">
      <h2 class="ob-head">{OFFER.head1}<br><span class="ob-pink">{OFFER.head2}</span></h2>
      <p class="ob-desc">{OFFER.text}</p>
      <a class="ob-cta" href={OFFER.href} target="_blank" rel="noopener sponsored nofollow">{OFFER.cta} <span aria-hidden="true">→</span></a>
      <p class="ob-mark">{OFFER.disclosure}</p>
    </div>
    <div class="ob-pic">
      <img src={OFFER.image} alt="Мама и дочка занимаются вместе" loading="lazy" width="1536" height="1024" />
    </div>
  </div>
</section>
<style>
  .offer-block{ max-width:980px; margin:46px auto 8px; padding:0 20px; }
  .ob-card{ display:grid; grid-template-columns:1.02fr .98fr; align-items:stretch;
    background:linear-gradient(135deg,#fdf1f1,#f8eef0); border-radius:26px; overflow:hidden;
    box-shadow:0 14px 40px rgba(45,26,32,.08); border:1px solid rgba(214,51,108,.08); }
  .ob-copy{ padding:34px 34px 26px; display:flex; flex-direction:column; justify-content:center; z-index:2; }
  .ob-head{ font-family:-apple-system,"Segoe UI",Arial,sans-serif; font-size:clamp(22px,2.7vw,29px);
    font-weight:800; line-height:1.18; color:#2d1a20; margin:0 0 14px; }
  .ob-pink{ color:#e84c8b; }
  .ob-desc{ font-size:15.5px; line-height:1.6; color:#6b5860; margin:0 0 22px; max-width:34ch; }
  .ob-cta{ align-self:flex-start; background:#e84c8b; color:#fff; font-weight:700; font-size:16px;
    padding:14px 30px; border-radius:999px; text-decoration:none; display:inline-flex; align-items:center; gap:12px;
    box-shadow:0 8px 22px rgba(232,76,139,.30); transition:transform .15s ease, background .15s ease; }
  .ob-cta:hover{ background:#d6336c; transform:translateY(-1px); }
  .ob-cta span{ font-size:18px; }
  .ob-mark{ font-size:11px; color:#9a8890; line-height:1.4; margin:12px 0 0; }
  .ob-pic{ position:relative; margin-left:-70px; min-height:100%; }
  .ob-pic img{ width:100%; height:100%; object-fit:cover; object-position:right center; display:block;
    -webkit-mask-image:linear-gradient(to right,transparent 0%,#000 34%);
    mask-image:linear-gradient(to right,transparent 0%,#000 34%); }
  @media(max-width:720px){
    .ob-card{ grid-template-columns:1fr; }
    .ob-pic{ order:-1; margin-left:0; aspect-ratio:3/2; }
    .ob-pic img{ -webkit-mask-image:none; mask-image:none; object-position:center; }
  }
</style>
