---
import { OFFER } from '../lib/site';
---
<section class="offer reveal">
  <div class="card">
    <p class="offer-lead">{OFFER.lead}</p>
    <p class="offer-text">{OFFER.text}</p>
    <a class="btn-glass" href={OFFER.href} target="_blank" rel="noopener sponsored nofollow">{OFFER.cta}</a>
    <p class="offer-ad">{OFFER.disclosure}</p>
  </div>
</section>
