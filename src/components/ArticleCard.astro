---
import { readingTime, formatDate } from '../lib/reading';
export interface Props {
  href: string;
  title: string;
  description: string;
  cover?: string;
  date: Date;
  body?: string;
  idx?: number;
}
const { href, title, description, cover, date, body = '', idx = 0 } = Astro.props;
const rt = readingTime(body);
const delay = ['', 'd1', 'd2'][idx % 3];
---
<a class={`card reveal ${delay}`} href={href}>
  {cover && <div class="thumb"><img src={cover} alt="" loading="lazy" /></div>}
  <div class="c-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="meta"><span>{formatDate(date)}</span><span class="dot"></span><span>{rt} мин</span></div>
  </div>
</a>
