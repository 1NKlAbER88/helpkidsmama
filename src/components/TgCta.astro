---
// Призыв подписаться на Telegram — главный канал ежедневных приёмов.
// Самодостаточный блок со своими стилями (не зависит от global.css).
const TG = 'https://t.me/help_kids_mama';
---
<aside class="tg-cta reveal">
  <div class="tg-ic" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3 2.95 11.63c-1.06.42-1.05 1.9.02 2.22l4.7 1.4 1.8 5.55c.28.86 1.36 1.06 1.94.35l2.5-2.98 4.78 3.5c.72.53 1.75.14 1.94-.73L23.94 5.4c.22-1-.79-1.86-2.04-1.1zM9.9 14.3l8.2-5.02c.16-.1.32.12.19.24l-6.72 6.1c-.24.22-.4.53-.44.86l-.2 1.85z"/></svg>
  </div>
  <div class="tg-txt">
    <strong>Понравился разбор? Такие — каждый день в Telegram</strong>
    <span>Короткие приёмы, чек-листы и живое общение. Без спама, по делу.</span>
  </div>
  <a class="tg-btn" href={TG} target="_blank" rel="noopener">Подписаться в Telegram</a>
</aside>
<style>
  .tg-cta{
    display:flex; align-items:center; gap:16px; flex-wrap:wrap;
    max-width:760px; margin:44px auto; padding:22px 24px;
    background:linear-gradient(135deg,#e9f4fb,#f7ecf0);
    border:1px solid rgba(41,163,227,.20); border-radius:20px;
    box-shadow:0 10px 30px rgba(45,26,32,.06);
  }
  .tg-ic{flex:0 0 auto; width:54px; height:54px; border-radius:50%;
    display:grid; place-items:center; background:#29a3e3; color:#fff;}
  .tg-ic svg{width:29px; height:29px}
  .tg-txt{flex:1 1 240px; display:flex; flex-direction:column; gap:4px}
  .tg-txt strong{font-size:1.1rem; line-height:1.3; color:#2d1a20}
  .tg-txt span{font-size:.95rem; color:#6b5860}
  .tg-btn{flex:0 0 auto; background:#29a3e3; color:#fff; font-weight:600;
    padding:13px 24px; border-radius:999px; text-decoration:none; white-space:nowrap;
    transition:transform .15s ease, background .15s ease;}
  .tg-btn:hover{background:#1e8fca; transform:translateY(-1px)}
  @media(max-width:560px){ .tg-cta{padding:18px; gap:14px} .tg-btn{width:100%; text-align:center} }
</style>
