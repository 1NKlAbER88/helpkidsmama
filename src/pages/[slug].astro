---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import { readingTime, formatDate } from '../lib/reading';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const rt = readingTime(entry.body);
---
<Base title={entry.data.title} description={entry.data.description} image={entry.data.cover} article={true}>
  <article class="article">
    <div class="a-meta">
      <span>Разбор</span><span class="dot"></span>
      <span>{formatDate(entry.data.pubDate)}</span><span class="dot"></span>
      <span>{rt} мин</span>
    </div>
    <h1>{entry.data.title}</h1>
    {entry.data.cover && (
      <div class="cover reveal"><img src={entry.data.cover} alt={entry.data.title} fetchpriority="high" /></div>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <Offer />
</Base>
