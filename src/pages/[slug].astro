---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import Reviews from '../components/Reviews.astro';
import { readingTime, formatDate } from '../lib/reading';

export async function getStaticPaths() {
  // Будущие статьи не билдятся, пока не наступит их день (ежедневный редеплой их проявит).
  const now = Date.now();
  const articles = (await getCollection('articles'))
    .filter((entry) => entry.data.pubDate.valueOf() <= now);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const rt = readingTime(entry.body);

// Блок «Другие статьи» под отзывами. Гибрид: первая ссылка — соседу по кругу
// (так входящие внутренние ссылки есть у КАЖДОЙ статьи, иначе часть остаётся «сиротами»
// и поисковики их не индексируют), ещё три — перемешанные, свои у каждой статьи.
const allPublished = (await getCollection('articles'))
  .filter((a) => a.data.pubDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const curIdx = allPublished.findIndex((a) => a.id === entry.id);
// детерминированный «рандом»: зависит от слага, поэтому у каждой статьи свой набор,
// но при пересборке ссылки не скачут хаотично
const seed = [...entry.id].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 100003, 7);
const pool = allPublished
  .map((a, i) => ({ a, i }))
  .filter(({ i }) => i !== curIdx && i !== (curIdx + 1) % allPublished.length)
  .sort((x, y) => ((x.i * seed) % 97) - ((y.i * seed) % 97))
  .map(({ a }) => a);
const related = [
  allPublished[(curIdx + 1) % allPublished.length],
  ...pool.slice(0, 3),
].filter((a, i, arr) => a && a.id !== entry.id && arr.findIndex((b) => b.id === a.id) === i);

---
<Base
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover}
  article={true}
  datePublished={entry.data.pubDate}
>
  <article class="article">
    <nav class="crumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span class="crumb-sep">→</span><span>Разбор</span>
    </nav>
    <div class="a-meta">
      <span>Разбор</span><span class="dot"></span>
      <span>{formatDate(entry.data.pubDate)}</span><span class="dot"></span>
      <span>{rt} мин</span>
    </div>
    <h1>{entry.data.title}</h1>
    {entry.data.cover && (
      <div class="cover reveal"><img src={entry.data.cover} alt={entry.data.title} fetchpriority="high" /></div>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <Offer />
  <Reviews slug={entry.id} />

  {related.length > 0 && (
    <section class="related">
      <h2>Другие статьи</h2>
      <div class="rel-grid">
        {related.map((a) => (
          <a class="rel-item" href={`/${a.id}/`}>
            {a.data.cover && <div class="rel-thumb"><img src={a.data.cover} alt="" loading="lazy" /></div>}
            <div class="rel-b">
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="rel-more">Читать →</span>
            </div>
          </a>
        ))}
      </div>
      <a class="rel-all" href="/">Все разборы →</a>
    </section>
  )}
</Base>

<style>
  .crumbs { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #9a8288; margin-bottom: 14px; }
  .crumbs a { color: #b8607a; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumb-sep { opacity: .5; }

  .related { max-width: 1080px; margin: 56px auto 72px; padding: 0 20px; }
  .related h2 { font-size: clamp(24px, 3vw, 32px); margin: 0 0 22px; color: #2d1a20; }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
  .rel-item {
    display: flex; flex-direction: column; background: #fff; border-radius: 18px; overflow: hidden;
    text-decoration: none; color: inherit; box-shadow: 0 6px 22px rgba(45, 26, 32, .07);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .rel-item:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(45, 26, 32, .12); }
  .rel-thumb { aspect-ratio: 3 / 2; overflow: hidden; }
  .rel-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rel-b { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .rel-b h3 { font-size: 17px; line-height: 1.3; margin: 0; color: #2d1a20; }
  .rel-b p {
    font-size: 14px; line-height: 1.45; margin: 0; color: #6f5b61;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rel-more { font-size: 14px; color: #b8607a; margin-top: auto; }
  .rel-all { display: inline-block; margin-top: 22px; font-size: 15px; color: #b8607a; text-decoration: none; }
  .rel-all:hover { text-decoration: underline; }
</style>
