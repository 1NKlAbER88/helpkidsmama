---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Subscribe from '../components/Subscribe.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featured, ...rest] = articles;
---
<Base title="Мамин Помощник — о детях 6–14 без нотаций">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="reveal">
        <span class="eyebrow">Спокойное родительство</span>
        <h1>Меньше криков. Больше контакта.</h1>
        <p class="lead">Короткие разборы про детей 6–14: что делать вместо запретов и нотаций — с примерами и нашими промахами.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={featured ? `/${featured.id}` : '#subscribe'}>Читать разборы</a>
          <a class="btn btn-ghost" href="#subscribe">Подписаться</a>
        </div>
      </div>
      <div class="hero-photo reveal d1">
        <img src="/images/brand/hero.png" alt="Мама и ребёнок читают вместе на диване" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Свежие разборы</h2></div>
    {featured && (
      <FeaturedArticle
        href={`/${featured.id}`}
        title={featured.data.title}
        description={featured.data.description}
        cover={featured.data.cover}
        date={featured.data.pubDate}
        body={featured.body}
      />
    )}
    {rest.length > 0 && (
      <div class="grid" style="margin-top: 32px;">
        {rest.map((a) => (
          <ArticleCard
            href={`/${a.id}`}
            title={a.data.title}
            description={a.data.description}
            cover={a.data.cover}
            date={a.data.pubDate}
            body={a.body}
          />
        ))}
      </div>
    )}
  </section>

  <section class="section wrap">
    <Subscribe />
  </section>
</Base>
