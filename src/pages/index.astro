---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Channels from '../components/Channels.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const topics = ['Истерики', 'Телефоны и экраны', 'Школа и оценки', 'Границы', 'Сон', 'Мотивация', 'Эмоции', 'Ссоры', 'Уроки без слёз', 'Свободное время'];
---
<Base title="Мамин Помощник — спокойное родительство без нотаций">
  <section class="hero" id="top">
    <div class="hero-bg"><img src="/images/brand/hero.png" alt="Мама и ребёнок читают книгу вместе" fetchpriority="high" /></div>
    <div class="content">
      <span class="eyebrow">Спокойное воспитание детей</span>
      <h1>Меньше криков.<br><i>Больше контакта.</i></h1>
      <p class="lead">Короткие разборы про детей: что делать вместо запретов и криков — с примерами и нашими промахами.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#articles">Читать разборы</a>
        <a class="btn btn-ghost" href="#channels">Наши каналы</a>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...topics, ...topics].map((t) => <span>{t}</span>)}
    </div>
  </div>

  <section class="section wrap" id="articles">
    <div class="section-head reveal">
      <h2>Разборы</h2>
      <p class="sub">Читаются за пять минут, применяются уже сегодня.</p>
    </div>
    <div class="grid">
      {articles.map((a, i) => (
        <ArticleCard
          href={`/${a.id}`}
          title={a.data.title}
          description={a.data.description}
          cover={a.data.cover}
          date={a.data.pubDate}
          body={a.body}
          idx={i}
        />
      ))}
    </div>
  </section>

  <Channels />
</Base>
