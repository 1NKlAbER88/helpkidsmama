---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readingTime, formatDate } from '../lib/reading';
import { SECTIONS, groupBySection } from '../lib/sections';
import { ICONS as SEC_ICONS } from '../lib/section-icons';

// Драфт-модель: статьи с датой в будущем скрыты до своего дня (проявляются при ежедневном редеплое).
const now = Date.now();
const articles = (await getCollection('articles'))
  .filter((a) => a.data.pubDate.valueOf() <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Раздел берётся из статьи, а если не указан — определяется по тегам.
// Статья, которую не удалось отнести никуда, видна в общей ленте, но о ней надо знать.
const { groups, orphans } = groupBySection(articles);
if (orphans.length) {
  console.warn(`[разделы] без раздела: ${orphans.map((a) => a.id).join(', ')}. ` +
    'Добавьте section: в фронтматтер или слово-подсказку в src/lib/sections.ts');
}
---
<Base
  title="Мамин Помощник — спокойное воспитание детей без криков и наказаний"
  description="Практические разборы для родителей: детские истерики и страхи, школа и домашние задания, ссоры между детьми, телефон, тревога и самостоятельность."
>
  <header class="hero">
    <div class="bg"><img src="/images/brand/hero.webp" alt="Мама и ребёнок вместе" fetchpriority="high" /></div>
    <div class="waves">
      <svg viewBox="0 0 1200 46" preserveAspectRatio="none"><path fill="#faf0f2" d="M0,12 C100,30 250,2 400,16 C550,32 700,4 850,18 C1000,32 1100,8 1200,14 L1200,46 L0,46 Z"/></svg>
      <svg viewBox="0 0 1200 46" preserveAspectRatio="none"><path fill="rgba(245,192,204,.5)" d="M0,16 C180,32 360,4 540,18 C720,32 900,6 1200,16 L1200,46 L0,46 Z"/></svg>
    </div>
    <div class="center">
      <div class="hand">как есть, без идеальной картинки</div>
      <h1>Спокойнее дома<br><i>Ближе к детям</i><span class="h1-key">Спокойное воспитание детей: короткие разборы без криков и нотаций</span></h1>
      <p class="desc">Что делать вместо запретов — с примерами, готовыми фразами и нашими промахами</p>
      <div class="cta-wrap">
        <a class="btn-ios" href="#list"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>Смотреть разборы</a>
      </div>
      <p class="platforms-hint">Короткие приёмы — в Telegram и MAX, большие разборы — на Дзене, идеи и карточки — на Pinterest</p>
    </div>
  </header>

  <section class="promo wrap">
    <div class="promo-b">
      <h2>Карточки для печати</h2>
      <p>Лабиринты, задания, чек листы и трекеры привычек. Готовые листы А4: скачать PDF бесплатно и сразу, без регистрации.</p>
      <a class="promo-cta" href="/kartochki/">Смотреть карточки →</a>
    </div>
  </section>

  <section class="sections wrap" id="sections">
    <div class="head reveal">
      <h2>Что сейчас происходит дома?</h2>
      <p>Выберите тему: внутри собраны разборы для самых частых ситуаций</p>
    </div>
    <div class="sec-list">
      {SECTIONS.map((s) => {
        const items = groups.get(s.id) ?? [];
        if (items.length === 0) return null;
        const word = items.length % 10 === 1 && items.length % 100 !== 11 ? 'статья'
          : [2, 3, 4].includes(items.length % 10) && ![12, 13, 14].includes(items.length % 100) ? 'статьи' : 'статей';
        return (
          <details class="sec reveal">
            <summary>
              <span class="sec-ic" set:html={SEC_ICONS[s.id]} />
              <span class="sec-txt">
                <span class="sec-name">{s.title}</span>
                <span class="sec-hint">{s.hint}</span>
              </span>
              <span class="sec-count">{items.length} {word}</span>
              <span class="sec-sign" aria-hidden="true"></span>
            </summary>
            <ul class="sec-items">
              {items.map((a) => (
                <li>
                  <a href={`/${a.id}/`}>
                    {a.data.cover && (
                      <span class="si-thumb">
                        {/* отдельная миниатюра 144×108: полноразмерная обложка тут весит в 30 раз больше */}
                        <img src={`/images/${a.id}/thumb.webp`} alt="" loading="lazy" decoding="async" width="72" height="54" />
                      </span>
                    )}
                    <span class="si-txt">
                      <span class="si-title">{a.data.title}</span>
                      <span class="si-sub">{a.data.description.split(/(?<=[?.!])\s/)[0]}</span>
                    </span>
                    <span class="si-go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        );
      })}
    </div>
  </section>

  <section class="articles wrap" id="list">
    <div class="head reveal">
      <h2>Свежие разборы</h2>
      <p>Читаются за пять минут, применяются уже сегодня</p>
    </div>
    <div class="grid">
      {articles.map((a, i) => (
        <a class={`item reveal ${['', 'd1', 'd2'][i % 3]}`} href={`/${a.id}/`}>
          {a.data.cover && <div class="thumb"><img src={a.data.cover} alt="" loading="lazy" /></div>}
          <div class="b">
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
            <div class="meta">
              <span>{formatDate(a.data.pubDate)}</span><span class="dot"></span>
              <span>{readingTime(a.body)} мин</span><span class="dot"></span>
              <span class="more">Читать →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="promo wrap">
    <div class="promo-b">
      <h2>Карточки для печати</h2>
      <p>Лабиринты, задания, чек листы и трекеры привычек. Готовые листы А4: скачать PDF бесплатно и сразу, без регистрации.</p>
      <a class="promo-cta" href="/kartochki/">Смотреть карточки →</a>
    </div>
  </section>
</Base>



<style>
  .promo { margin: 10px auto 64px; }
  .promo-b {
    background: linear-gradient(135deg, #fdeef5 0%, #f4f0fb 100%);
    border-radius: 22px; padding: 30px 28px; text-align: center;
  }
  .promo-b h2 { font-size: clamp(24px, 3vw, 30px); margin: 0 0 10px; color: #2d1a20; }
  .promo-b p { font-size: 17px; color: #5b4750; margin: 0 auto 18px; max-width: 560px; line-height: 1.6; }
  .promo-cta {
    display: inline-block; background: #b8607a; color: #fff; text-decoration: none;
    font-weight: 700; padding: 13px 24px; border-radius: 13px; transition: background .15s;
  }
  .promo-cta:hover { background: #a04f68; }
  .sections { padding-top: 8px; }
  .sections .head { text-align: center; margin-bottom: 26px; }
  .sections .head p { color: #9a8288; margin-top: 8px; }
  /* на широком экране карточка во всю ширину выглядит вытянутой — раскладываем 2×2 */
  .sec-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  @media (max-width: 860px) { .sec-list { grid-template-columns: 1fr; gap: 12px; } }

  .sec {
    background: #fff; border: 1px solid #f0e2e6; border-radius: 16px;
    box-shadow: 0 4px 16px rgba(45, 26, 32, .05); overflow: hidden;
  }
  .sec[open] { box-shadow: 0 10px 28px rgba(45, 26, 32, .09); }

  .sec summary {
    display: flex; align-items: center; gap: 14px; padding: 20px 22px;
    cursor: pointer; list-style: none; user-select: none;
  }
  .sec summary::-webkit-details-marker { display: none; }

  .sec-ic { flex: 0 0 auto; width: 26px; height: 26px; color: #c45b7a; display: block; }
  .sec-ic :global(svg) { width: 26px; height: 26px; display: block; }

  .sec-txt { flex: 1 1 auto; min-width: 0; }
  .sec-name { display: block; font-size: 20px; font-weight: 700; color: #2d1a20; line-height: 1.25; }
  .sec-hint { display: block; margin-top: 3px; font-size: 15px; color: #9a8288; line-height: 1.4; }

  .sec-count { flex: 0 0 auto; font-size: 13px; color: #b09aa1; white-space: nowrap; }

  .sec-sign { flex: 0 0 auto; position: relative; width: 16px; height: 16px; }
  .sec-sign::before, .sec-sign::after {
    content: ""; position: absolute; background: #c45b7a; border-radius: 2px;
    transition: transform .25s ease, opacity .25s ease;
  }
  .sec-sign::before { left: 0; top: 7px; width: 16px; height: 2px; }
  .sec-sign::after { left: 7px; top: 0; width: 2px; height: 16px; }
  .sec[open] .sec-sign::after { transform: rotate(90deg); opacity: 0; }

  .sec-items { list-style: none; margin: 0; padding: 4px 12px 12px; }
  .sec-items li + li { border-top: 1px solid #f6ecef; }
  .sec-items a {
    display: flex; align-items: center; gap: 14px; padding: 11px 10px; border-radius: 12px;
    text-decoration: none; transition: background .18s ease;
  }
  /* подсветка всей строки, а не одного заголовка */
  .sec-items a:hover { background: #fdf4f7; }
  .sec-items li:has(a:hover) + li { border-top-color: transparent; }

  .si-thumb {
    flex: 0 0 auto; width: 72px; height: 54px; border-radius: 9px; overflow: hidden;
    background: #f7e2e9; box-shadow: 0 2px 8px rgba(45, 26, 32, .08);
  }
  .si-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
  .sec-items a:hover .si-thumb img { transform: scale(1.06); }

  .si-txt { flex: 1 1 auto; min-width: 0; }
  .si-title { display: block; font-size: 16px; line-height: 1.35; color: #2d1a20; font-weight: 600; transition: color .18s ease; }
  .si-sub { display: block; margin-top: 3px; font-size: 14px; line-height: 1.4; color: #9a8288; }
  .sec-items a:hover .si-title { color: #a8455f; }

  .si-go { flex: 0 0 auto; color: #d9bcc5; font-size: 17px; transition: color .18s ease, transform .18s ease; }
  .sec-items a:hover .si-go { color: #c45b7a; transform: translateX(3px); }

  @media (max-width: 560px) {
    .sec summary { padding: 17px 16px; gap: 11px; }
    .sec-name { font-size: 18px; }
    .sec-hint { font-size: 14px; }
    .sec-count { display: none; }
    .sec-items { padding: 2px 8px 10px; }
    .sec-items a { gap: 11px; padding: 10px 8px; }
    .si-thumb { width: 58px; height: 44px; }
    .si-title { font-size: 15px; }
    .si-sub { font-size: 13px; }
    .si-go { display: none; }
  }

  .sections { padding-top: 8px; }
</style>
