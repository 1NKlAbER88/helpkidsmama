---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Subscribe from '../components/Subscribe.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Мамин Помощник — о детях 6–14 без нотаций">
  <section class="hero wrap">
    <h1>Спокойное родительство без нотаций</h1>
    <p>Короткие разборы про детей 6–14: что делать вместо криков и запретов — с примерами и нашими промахами.</p>
  </section>
  <div class="wrap">
    <div class="grid">
      {articles.map((a) => (
        <ArticleCard
          href={`/${a.id}`}
          title={a.data.title}
          description={a.data.description}
          cover={a.data.cover}
          date={a.data.pubDate}
        />
      ))}
    </div>
    <Subscribe />
  </div>
</Base>
