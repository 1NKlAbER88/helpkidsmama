---
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { SOCIALS, ICONS } from '../lib/socials';
import { VERIFICATION } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  datePublished?: Date;
  dateModified?: Date;
  faq?: { q: string; a: string }[];
}
const {
  title,
  description = 'Спокойное воспитание детей без криков и нотаций: короткие разборы, что делать вместо запретов — с примерами.',
  image,
  article = false,
  datePublished,
  dateModified,
  faq = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/images/brand/hero.webp', Astro.site).href;
const siteName = 'Мамин Помощник';
const siteUrl = new URL('/', Astro.site).href;
const logoUrl = new URL('/images/brand/logo-mark-v2.webp', Astro.site).href;

// --- Структурированные данные (JSON-LD) ---
const orgNode = {
  '@type': 'Organization',
  name: siteName,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: logoUrl },
  sameAs: SOCIALS.map((s) => s.href),
};
const pub = datePublished instanceof Date ? datePublished.toISOString() : undefined;
const mod = dateModified instanceof Date ? dateModified.toISOString() : pub;
// Блок «Частые вопросы» есть почти в каждой статье — отдаём его поисковику
// разметкой FAQPage: это шанс на расширенный сниппет с раскрывающимися вопросами.
const faqNode = faq.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }]
  : [];
const jsonLd = article
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        inLanguage: 'ru',
        datePublished: pub,
        dateModified: mod,
        mainEntityOfPage: canonical,
        author: orgNode,
        publisher: orgNode,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
          { '@type': 'ListItem', position: 2, name: title, item: canonical },
        ],
      },
      ...faqNode,
    ]
  : [
      { '@context': 'https://schema.org', ...orgNode },
      { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, url: siteUrl, inLanguage: 'ru' },
    ];

// Google Analytics 4: ID из env PUBLIC_GA4_ID (напр. G-XXXXXXX), задать при сборке. Пусто — не рендерится.
const ga4Id = import.meta.env.PUBLIC_GA4_ID || 'G-GBDJ0THHWX';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="zen-verification" content="BjrCQGlbCsZEfQAeDSIOzq25UQZsoo9x6XRWTb8cvZtEiTuOsjIYDKg7IoMiMb98" />
  <meta name="p:domain_verify" content="e00642d6c22b6357e9aa906bf1416b86" />
  {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
  {VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#2d1a20" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {article && pub && <meta property="article:published_time" content={pub} />}
  {article && mod && <meta property="article:modified_time" content={mod} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {jsonLd.map((node) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
  ))}
  {ga4Id && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`} />
    </Fragment>
  )}
</head>
<body>
  <header class={`nav${article ? ' solid' : ''}`} id="nav">
    <div class="bar">
      <a class="brand" href="/"><img src="/images/brand/logo-mark-v2.webp" alt="" width="34" height="34" />Мамин <span>Помощник</span></a>
      <nav class="socials">
        {SOCIALS.map((s) => (
          <a class={`soc ${s.cls}`} href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
            <span set:html={ICONS[s.cls]} />{s.name}
          </a>
        ))}
      </nav>
    </div>
  </header>
  {article && <div class="progress"><div class="progress-fill" id="pf"></div></div>}

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="ft-brand">
      <img src="/images/brand/logo-mark-v2.webp" alt="" width="30" height="30" />
      <span class="ft-name">Мамин <span>Помощник</span></span>
    </div>
    <p class="ft-desc">Спокойное родительство без нотаций — что делать вместо криков и запретов, с примерами и нашими промахами</p>
    <div class="ft-links">
      {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.name}</a>)}
    </div>
    <p class="ft-copy">© <span id="yr"></span> Мамин Помощник · helpkidsmama.ru</p>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.getElementById('nav');
      if (nav && !nav.classList.contains('solid')) {
        var os = function () { if (window.scrollY > 40) nav.classList.add('solid'); else nav.classList.remove('solid'); };
        os();
        window.addEventListener('scroll', os, { passive: true });
      }
      var pf = document.getElementById('pf');
      if (pf) {
        var upd = function () {
          var h = document.documentElement;
          var m = h.scrollHeight - h.clientHeight;
          pf.style.width = (m > 0 ? (h.scrollTop / m * 100) : 0) + '%';
        };
        upd();
        window.addEventListener('scroll', upd, { passive: true });
        window.addEventListener('resize', upd);
      }
      var y = document.getElementById('yr');
      if (y) y.textContent = new Date().getFullYear();
    })();
  </script>
</body>
</html>
