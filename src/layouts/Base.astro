---
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource-variable/onest';
import '../styles/global.css';
import { SOCIALS, ICONS } from '../lib/socials';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}
const {
  title,
  description = 'Спокойное воспитание детей без криков и нотаций: короткие разборы, что делать вместо запретов — с примерами.',
  image,
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/images/brand/hero.webp', Astro.site).href;
const siteName = 'Мамин Помощник';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#2d1a20" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <header class={`nav${article ? ' solid' : ''}`} id="nav">
    <div class="bar">
      <a class="brand" href="/"><img src="/images/brand/logo-mark.webp" alt="" width="34" height="34" />Мамин <span>Помощник</span></a>
      <nav class="socials">
        {SOCIALS.map((s) => (
          <a class={`soc ${s.cls}`} href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
            <span set:html={ICONS[s.cls]} />{s.name}
          </a>
        ))}
      </nav>
    </div>
  </header>
  {article && <div class="progress"><div class="progress-fill" id="pf"></div></div>}

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="ft-brand">
      <img src="/images/brand/logo-mark.webp" alt="" width="30" height="30" />
      <span class="ft-name">Мамин <span>Помощник</span></span>
    </div>
    <p class="ft-desc">Спокойное родительство без нотаций — что делать вместо криков и запретов, с примерами и нашими промахами</p>
    <div class="ft-links">
      {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.name}</a>)}
    </div>
    <p class="ft-copy">© <span id="yr"></span> Мамин Помощник · helpkidsmama.ru</p>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.getElementById('nav');
      if (nav && !nav.classList.contains('solid')) {
        var os = function () { if (window.scrollY > 40) nav.classList.add('solid'); else nav.classList.remove('solid'); };
        os();
        window.addEventListener('scroll', os, { passive: true });
      }
      var pf = document.getElementById('pf');
      if (pf) {
        var upd = function () {
          var h = document.documentElement;
          var m = h.scrollHeight - h.clientHeight;
          pf.style.width = (m > 0 ? (h.scrollTop / m * 100) : 0) + '%';
        };
        upd();
        window.addEventListener('scroll', upd, { passive: true });
        window.addEventListener('resize', upd);
      }
      var y = document.getElementById('yr');
      if (y) y.textContent = new Date().getFullYear();
    })();
  </script>
</body>
</html>
