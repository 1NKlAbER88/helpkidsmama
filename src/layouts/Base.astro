---
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource-variable/onest';
import '../styles/global.css';
import Social from '../components/Social.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}
const {
  title,
  description = 'Спокойное родительство без нотаций: короткие разборы, что делать вместо криков и запретов — с примерами.',
  image,
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/images/brand/hero.png', Astro.site).href;
const siteName = 'Мамин Помощник';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#f6f1e8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body class="js">
  <header class="nav" id="nav">
    <div class="wrap bar">
      <a class="brand" href="/"><img src="/images/brand/logo-mark.png" alt="" />Мамин Помощник</a>
      <div class="nav-right">
        <Social variant="nav" />
        <a class="btn btn-primary" href="https://t.me/help_kids_mama" target="_blank" rel="noopener">В Telegram</a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap cols">
      <div>
        <a class="brand" href="/"><img src="/images/brand/logo-mark.png" alt="" />Мамин Помощник</a>
        <p>Спокойное родительство без нотаций. Что делать вместо криков и запретов — с примерами и промахами.</p>
      </div>
      <div>
        <Social variant="footer" />
      </div>
    </div>
    <div class="wrap copy">© <span id="yr"></span> Мамин Помощник · helpkidsmama.ru</div>
  </footer>

  <script is:inline>
    const nav = document.getElementById('nav');
    const onScroll = () => {
      if (window.scrollY > 40) nav.classList.add('solid');
      else nav.classList.remove('solid');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    const yr = document.getElementById('yr');
    if (yr) yr.textContent = new Date().getFullYear();
  </script>
</body>
</html>
